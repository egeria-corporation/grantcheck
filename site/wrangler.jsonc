{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "check-opengrants-io",
  "main": "src/index.tsx",
  "compatibility_date": "2026-01-01",
  // Invocation logs OFF, deliberately.
  //
  // An invocation log records the request — including its URL — for 7 days. For this site the
  // URL *is* the sensitive fact: /ein/12-3456789 is a record of who looked up which
  // organization, which is precisely what the architecture's privacy section forbids and what
  // the sign-in page promises we do not keep. Leaving them on would have meant weakening the
  // promise to match the infrastructure; this changes the infrastructure to match the promise.
  //
  // Custom logs still work, so console.error on a failed mail send is still visible. What is
  // given up is per-request debugging, which is a fair price and, if it is ever really needed,
  // can be bought back temporarily with `wrangler tail` rather than by retaining logs.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },

  // Edge SSR from D1, not a pre-rendered site. There are ~1.4M 501(c)(3) organizations and
  // Cloudflare Pages allows 20,000 files per deployment on the free plan, 100,000 on paid.
  // Pre-rendering one page per organization exceeds the paid ceiling by an order of
  // magnitude and blows the 20-minute build timeout. See docs/ADR-001.md.
  "d1_databases": [
    {
      // Bound as DB rather than "grantcheck": the binding is the variable name the Worker
      // sees, and env.DB reads better at every call site than env.grantcheck.
      "binding": "DB",
      "database_name": "grantcheck",
      "database_id": "47f8d371-73d3-4eaa-ae9d-706fbf06d46c"
    }
  ],

  // The 8th at 14:00 UTC. The IRS publishes the monthly files in the first week; this
  // gives the ingest time to land before anyone is told their roster changed.
  "triggers": {
    "crons": ["0 14 8 * *"]
  },

  "routes": [
    {
      "pattern": "check.opengrants.io",
      "custom_domain": true
    }
  ]
}
